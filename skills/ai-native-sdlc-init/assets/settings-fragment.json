{
  "plansDirectory": "docs/plans",
  "worktree": { "baseRef": "head" },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit-verify.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
